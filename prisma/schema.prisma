// YouTube Auto-Channel Monetization Engine
// Supports BOTH local SQLite (file:./db/custom.db) and Turso (libsql://...)
// via the libsql driver adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// === NextAuth.js models ===

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  videos           VideoProject[]
  youtubeTokens    YouTubeToken[]
  publishingSlots  PublishingSlot[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

// === App models ===

// A tracked niche with trend + monetization metrics.
// Niches are GLOBAL — shared across all users as reference data.
model Niche {
  id                   String   @id @default(cuid())
  name                 String   @unique
  category             String
  cpmLow               Float
  cpmHigh              Float
  shortsRpm            Float
  trendScore           Float
  competition          Float
  evergreenFactor      Float
  automationEase       Float
  monetizationSafety   Float    @default(0.7)
  compositeScore       Float
  sampleChannels       String?
  bestFor              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  videos VideoProject[]
}

// A video in the production pipeline — linked to a user
model VideoProject {
  id           String   @id @default(cuid())
  userId       String?
  nicheId      String
  niche        Niche    @relation(fields: [nicheId], references: [id])
  title        String
  hook         String?
  format       String
  status       String
  scriptJson   String?
  voiceoverUrl String?
  thumbnailUrl String?
  durationSec  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  scenes  Scene[]
  assets  GeneratedAsset[]
  slots   PublishingSlot[]
}

// A scene in the storyboard
model Scene {
  id           String   @id @default(cuid())
  videoId      String
  video        VideoProject @relation(fields: [videoId], references: [id], onDelete: Cascade)
  order        Int
  heading      String
  narration    String
  brollPrompt  String
  durationSec  Int      @default(8)
  imageUrl     String?
  audioUrl     String?
  createdAt    DateTime @default(now())
}

// Generated assets (audio, image) — file URLs cached
model GeneratedAsset {
  id           String   @id @default(cuid())
  videoId      String
  video        VideoProject @relation(fields: [videoId], references: [id], onDelete: Cascade)
  type         String
  url          String
  metaJson     String?
  createdAt    DateTime @default(now())
}

// Scheduled publishing slot — linked to a user via video
model PublishingSlot {
  id           String   @id @default(cuid())
  userId       String?
  videoId      String
  video        VideoProject @relation(fields: [videoId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  platform     String   @default("youtube")
  publishedAt  DateTime?
  viewsActual  Int      @default(0)
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Monetization record (projection or actual)
model MonetizationRecord {
  id               String   @id @default(cuid())
  monthKey         String
  nicheName        String
  format           String
  projectedViews   Int
  estimatedCpm     Float
  estimatedRpm     Float
  projectedRevenue Float
  actualRevenue    Float?
  createdAt        DateTime @default(now())
}

// YouTube OAuth tokens — per-user (id = userId)
model YouTubeToken {
  id           String    @id
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  channelId    String?
  channelTitle String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}
