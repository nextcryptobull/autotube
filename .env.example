# AutoTube Studio — Environment Variables
# Copy this file to `.env` (local) or set these in your Vercel project settings.

# Prisma database connection string.
# Local dev: SQLite file path relative to project root.
# Vercel/production: SQLite is read-only on serverless; use a real DB instead.
#   Example: "postgresql://user:pass@host:5432/autotube?schema=public"
DATABASE_URL="file:./db/custom.db"
